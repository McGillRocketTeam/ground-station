# Copy this file to .env next to compose.yml.
WIFI_ROUTER_PASSWORD=
MRT_GOJS_API_KEY=
YAMCS_INSTANCE=launch-canada
YAMCS_PROCESSOR=realtime

# Browser-reachable URL, not the Docker service name. The default works locally.
MQTT_BROWSER_URL=ws://localhost:9001

# Comma-separated browser-reachable hostnames or IPs advertised as WebRTC ICE
# candidates. Set this to the server's LAN IP or public DNS name when clients
# are not running on the Docker host. TCP and UDP port 8189 must be reachable.
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=

# Required only with: docker compose --profile ecoflow up -d
ECOFLOW_USER_ID=

# Host ports can be overridden as needed.
FRONTEND_PORT=5173
MEDIA_FRONTEND_PORT=5174
BACKEND_PORT=8090
MEDIA_BACKEND_PORT=3000
MBTILESERVER_PORT=3001
MQTT_PORT=1883
MQTT_WEBSOCKET_PORT=9001
