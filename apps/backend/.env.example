# Copy to .env, replace the value, and export it before starting Yamcs.
WIFI_ROUTER_PASSWORD=replace-with-router-password
OMADA_CLIENT_ID=replace-with-open-api-client-id
OMADA_CLIENT_SECRET=replace-with-open-api-client-secret
# Serial device shown by `ls /dev/tty.*` when the Ground Station V2 is connected.
FEATHERWEIGHT_SERIAL_DEVICE=/dev/tty.usbmodem-featherweight
